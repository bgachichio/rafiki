{
  "name": "rafiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rafiki: a personal agent on Telegram, running on Cloudflare Workers and D1",
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
