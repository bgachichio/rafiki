    "limits": "node scripts/sync-limits.ts",
    "scan": "./scripts/privacy-scan.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  },
